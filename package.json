{
  "name": "@digicatapult/sqnc-attachment-api",
  "version": "3.3.0",
  "description": "An OpenAPI Matchmaking API service for SQNC",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "check": "npm run build:tsoa && tsc --noEmit",
    "depcheck": "depcheck",
    "build:tsoa": "tsoa spec-and-routes",
    "build": "tsoa spec-and-routes && swc ./src -d ./build --strip-leading-paths --copy-files",
    "start": "node build/index.js",
    "dev": "concurrently \"NODE_ENV=dev nodemon | pino-colada\" \"nodemon -x tsoa spec-and-routes --ignore src/routes.ts --ignore src/swagger.json\"",
    "dev:telemetry": "concurrently -k \"NODE_ENV=dev NODE_OPTIONS='--require @opentelemetry/auto-instrumentations-node/register' GRPC_INSECURE=true OTEL_SERVICE_NAME='sqnc-attachment-api' OTEL_EXPORTER_OTLP_TRACES_PROTOCOL='grpc' OTEL_EXPORTER_OTLP_TRACES_ENDPOINT='http://localhost:4317' OTEL_TRACES_EXPORTER='otlp' OTEL_PROPAGATORS='tracecontext,baggage' nodemon | pino-colada\" \"nodemon -x tsoa spec-and-routes --ignore src/routes.ts --ignore src/swagger.json\"",
    "test:integration": "NODE_ENV=test NODE_OPTIONS='--no-experimental-strip-types' ./node_modules/.bin/mocha --config ./test/mocharc.json ./test/integration/*.test.ts",
    "test:unit": "NODE_ENV=test ./node_modules/.bin/mocha --config ./test/mocharc.json ./src/**/*.test.ts",
    "db:cmd": "node --import @swc-node/register/esm-register ./node_modules/.bin/knex",
    "db:migrate": "npm run db:cmd -- migrate:latest --knexfile src/lib/db/knexfile.ts",
    "db:rollback": "npm run db:cmd -- migrate:rollback --knexfile src/lib/db/knexfile.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digicatapult/sqnc-attachment-api.git"
  },
  "engines": {
    "node": "^22.x.x",
    "npm": "^10.x.x"
  },
  "keywords": [
    "OpenAPI"
  ],
  "author": "Digital Catapult",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/digicatapult/sqnc-attachment-api/issues"
  },
  "homepage": "https://github.com/digicatapult/sqnc-attachment-api#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@swc-node/register": "^1.10.10",
    "@swc/cli": "^0.7.8",
    "@types/chai": "^5.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.9",
    "@types/sinon": "^17.0.4",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "chai": "^5.2.1",
    "concurrently": "^9.2.0",
    "depcheck": "^1.4.7",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^16.3.0",
    "mocha": "^11.7.1",
    "nodemon": "^3.1.10",
    "pino-colada": "^2.2.2",
    "prettier": "^3.6.2",
    "sinon": "^21.0.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "undici": "^7.12.0"
  },
  "dependencies": {
    "@digicatapult/tsoa-oauth-express": "^2.0.16",
    "@grpc/grpc-js": "^1.13.4",
    "@opentelemetry/auto-instrumentations-node": "^0.62.0",
    "@tsoa/runtime": "^6.6.0",
    "@tweedegolf/sab-adapter-amazon-s3": "^1.0.17",
    "@tweedegolf/sab-adapter-azure-blob": "^1.0.7",
    "@tweedegolf/storage-abstraction": "^2.1.6",
    "blockstore-core": "^5.0.4",
    "content-disposition": "^0.5.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "envalid": "^8.1.0",
    "express": "^5.1.0",
    "express-prom-bundle": "^8.0.0",
    "ipfs-unixfs-importer": "^15.4.0",
    "it-all": "^3.0.9",
    "knex": "^3.1.0",
    "moment": "^2.30.1",
    "multiformats": "^13.3.7",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pino": "9.7.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "tsyringe": "^4.10.0",
    "zod": "^4.0.14"
  }
}
