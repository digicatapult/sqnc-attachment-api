{
  "name": "@digicatapult/sqnc-attachment-api",
  "version": "3.3.71",
  "description": "An OpenAPI Matchmaking API service for SQNC",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "check": "npm run build:tsoa && tsc --noEmit",
    "depcheck": "depcheck",
    "build:tsoa": "tsoa spec-and-routes",
    "build": "tsoa spec-and-routes && swc ./src -d ./build --strip-leading-paths --copy-files",
    "start": "node build/index.js",
    "dev": "concurrently \"NODE_ENV=dev nodemon | pino-colada\" \"nodemon -x tsoa spec-and-routes --ignore src/routes.ts --ignore src/swagger.json\"",
    "dev:telemetry": "concurrently -k \"NODE_ENV=dev NODE_OPTIONS='--require @opentelemetry/auto-instrumentations-node/register' GRPC_INSECURE=true OTEL_SERVICE_NAME='sqnc-attachment-api' OTEL_EXPORTER_OTLP_TRACES_PROTOCOL='grpc' OTEL_EXPORTER_OTLP_TRACES_ENDPOINT='http://localhost:4317' OTEL_TRACES_EXPORTER='otlp' OTEL_PROPAGATORS='tracecontext,baggage' nodemon | pino-colada\" \"nodemon -x tsoa spec-and-routes --ignore src/routes.ts --ignore src/swagger.json\"",
    "test:integration": "NODE_OPTIONS=--no-experimental-strip-types NODE_ENV=test ./node_modules/.bin/mocha --config ./test/mocharc.json ./test/integration/*.test.ts",
    "test:unit": "NODE_OPTIONS=--no-experimental-strip-types NODE_ENV=test ./node_modules/.bin/mocha --config ./test/mocharc.json ./src/**/*.test.ts",
    "db:cmd": "node --import @swc-node/register/esm-register ./node_modules/.bin/knex",
    "db:migrate": "npm run db:cmd -- migrate:latest --knexfile src/lib/db/knexfile.ts",
    "db:rollback": "npm run db:cmd -- migrate:rollback --knexfile src/lib/db/knexfile.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digicatapult/sqnc-attachment-api.git"
  },
  "engines": {
    "node": "^22.x.x",
    "npm": "^10.x.x"
  },
  "keywords": [
    "OpenAPI"
  ],
  "author": "Digital Catapult",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/digicatapult/sqnc-attachment-api/issues"
  },
  "homepage": "https://github.com/digicatapult/sqnc-attachment-api#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@swc-node/register": "^1.11.1",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.8",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.27",
    "@types/sinon": "^21.0.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "chai": "^6.2.2",
    "concurrently": "^9.2.1",
    "depcheck": "^1.4.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.11",
    "pino-colada": "^2.2.2",
    "prettier": "^3.7.4",
    "sinon": "^21.0.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "undici": "^7.18.2"
  },
  "dependencies": {
    "@digicatapult/tsoa-oauth-express": "^2.0.59",
    "@grpc/grpc-js": "^1.14.3",
    "@opentelemetry/auto-instrumentations-node": "^0.67.3",
    "@tsoa/runtime": "^6.6.0",
    "@tweedegolf/sab-adapter-s3": "^3.0.3",
    "@tweedegolf/sab-adapter-azure-blob": "^3.0.1",
    "@tweedegolf/storage-abstraction": "^3.0.3",
    "blockstore-core": "^6.1.1",
    "content-disposition": "^1.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "express-prom-bundle": "^8.0.0",
    "ipfs-unixfs-importer": "^16.0.1",
    "it-all": "^3.0.9",
    "knex": "^3.1.0",
    "moment": "^2.30.1",
    "multer": "^2.0.2",
    "multiformats": "^13.4.2",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "tsyringe": "^4.10.0",
    "zod": "^4.3.5"
  }
}
